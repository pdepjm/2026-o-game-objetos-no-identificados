import salas.*
import logicaJuego.*
import personaje.*

describe "salas" {

  test "al entrar a sala1 aparecen sus 3 enemigos y todavia no esta limpia" {
    miJuego.entrarA(sala1)
    assert.equals(3, sala1.enemigosVivos().size())
    assert.notThat(sala1.estaLimpia())
  }

  test "al entrar a sala2 aparecen sus 5 enemigos" {
    miJuego.entrarA(sala2)
    assert.equals(5, sala2.enemigosVivos().size())
  }

  test "el personaje aparece en el punto de entrada de la sala" {
    miJuego.entrarA(sala1)
    assert.equals(sala1.puntoDeEntrada(), personaje.position())
  }

  test "eliminar un enemigo lo saca de la sala pero no la limpia" {
    miJuego.entrarA(sala1)
    const enemigo = sala1.enemigosVivos().first()
    miJuego.eliminarEnemigo(enemigo)
    assert.equals(2, sala1.enemigosVivos().size())
    assert.notThat(sala1.estaLimpia())
  }

  test "con la puerta bloqueada no se pasa de sala" {
    miJuego.entrarA(sala1)
    sala1.puerta().alColisionarConPersonaje()
    assert.equals(sala1, miJuego.salaActual())
  }

  test "al eliminar todos los enemigos se desbloquea la puerta y se puede pasar a la sala siguiente" {
    miJuego.entrarA(sala1)
    sala1.enemigosVivos().copy().forEach({ enemigo => miJuego.eliminarEnemigo(enemigo) })
    assert.that(sala1.estaLimpia())
    sala1.puerta().alColisionarConPersonaje()
    assert.equals(sala2, miJuego.salaActual())
    assert.equals(5, sala2.enemigosVivos().size())
  }

  test "cada vez que se entra a una sala se generan enemigos nuevos y la puerta vuelve a estar bloqueada" {
    miJuego.entrarA(sala1)
    sala1.enemigosVivos().copy().forEach({ enemigo => miJuego.eliminarEnemigo(enemigo) })
    miJuego.entrarA(sala1)
    assert.equals(3, sala1.enemigosVivos().size())
    sala1.puerta().alColisionarConPersonaje()
    assert.equals(sala1, miJuego.salaActual())
  }

  test "los enemigos y la puerta no son atacables, y el personaje tampoco" {
    miJuego.entrarA(sala1)
    assert.that(sala1.enemigosVivos().first().esAtacable())
    assert.notThat(sala1.puerta().esAtacable())
    assert.notThat(personaje.esAtacable())
  }

  test "atacar 4 veces a un enemigo lo mata y lo saca de la sala" {
    miJuego.entrarA(sala1)
    const enemigo = sala1.enemigosVivos().first()
    4.times({ i => personaje.atacarEn(enemigo.position()) })
    assert.equals(2, sala1.enemigosVivos().size())
    assert.notThat(sala1.enemigosVivos().contains(enemigo))
  }

  test "hacer clic sobre la puerta o sobre el personaje no rompe nada" {
    miJuego.entrarA(sala1)
    // se mueve la puerta a una celda sin enemigos para que el clic caiga solo sobre ella
    sala1.puerta().position(game.at(20, 20))
    assert.doesNotThrowException({ personaje.atacarEn(sala1.puerta().position()) })
    assert.doesNotThrowException({ personaje.atacarEn(personaje.position()) })
  }

  test "un enemigo que toca al personaje no rompe y al perder las 3 vidas termina el juego sin errores" {
    miJuego.entrarA(sala1)
    const enemigo = sala1.enemigosVivos().first()
    assert.doesNotThrowException({ 4.times({ i => personaje.reaccionarAColision(enemigo) }) })
  }

}
