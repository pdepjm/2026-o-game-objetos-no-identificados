import wollok.game.*
import personaje.personaje.*
import enemigos.enemigoComun.*

program Game {
 // Nombre del juego
  game.title("Ejemplo")
  // Definir proporciones
  game.height(-)
  game.width(-)
  game.cellSize(-)
  


  game.addVisualCharacter(personaje)
  game.addVisual(enemigoComun)


  const tick = game.tick(500, { enemigoComun.perseguir() }, false)
  tick.start()


  game.onCollideDo(enemigoComun, { elemento => personaje.perderVida() })
  ggame.onCollideDo(personaje, { elemento =>
    elemento.chocarCon(personaje)
  })
  game.start()

}
