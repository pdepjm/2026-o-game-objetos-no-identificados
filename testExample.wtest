import wollok.game.*
import salas.*
import personaje.*
import enemigos.*
import puerta.*
import paredes.*
import logicaJuego.*
import temporizador.*
import items.*
import tablero.*
import estadoFinal.*
import generadorDeMonstruos.*

describe "Personaje" {
  test "Pierde una vida cuando recibe un ataque" {
    game.addVisual(personaje)
    personaje.perderVidaActual()
    assert.equals(2, personaje.vidaActual())
  }

  test "Al recuperar vida no supera la vida máxima" {
    game.addVisual(personaje)
    personaje.perderVidaActual()
    personaje.recuperarVidaActual(5)
    assert.equals(3, personaje.vidaActual())
  }
}

describe "Enemigo" {
  test "Recibe daño" {
    const enemigo = new EnemigoComun(position = game.at(5, 5))
    game.addVisual(enemigo)
    enemigo.recibirDanio(balaComun)
    assert.equals(75, enemigo.vida())
  }

  test "Muere cuando su vida llega a cero" {
    const enemigo = new EnemigoComun(position = game.at(5, 5))
    game.addVisual(enemigo)

    4.times({ i => enemigo.recibirDanio(balaComun) })

    assert.that(enemigo.estaMuerto())
  }
}

describe "Puerta" {
  test "La puerta comienza bloqueada" {
    const puerta = new Puerta(destino = sala2)
    assert.notThat(puerta.desbloqueada())
  }
}

describe "Sala" {
  test "La sala comienza con enemigos" {
    sala1.inicializarse()
    assert.notThat(sala1.estaLimpia())
  }
}

describe "Paredes" {
  method initialize() {
game.width(15)
    game.height(20)
  }

  // el bloqueo de celdas
  test "Una pared interna bloquea su celda y no las vecinas" {
    paredes.construir(paredes.horizontal(3, 5, 9))
    assert.that(paredes.bloquea(game.at(4, 9)))
    assert.notThat(paredes.bloquea(game.at(4, 10)))
  }
}

describe "Movimiento" {
  method initialize() {
    game.width(15)
    game.height(20)
    personaje.position(game.at(5, 5))
  }

  // el personaje contra una pared
  test "El personaje no atraviesa una pared interna" {
    paredes.construir(paredes.horizontal(6, 6, 5))
    personaje.mover(game.at(6, 5))
    assert.equals(game.at(5, 5), personaje.position())
  }

  // el enemigo contra una pared
  test "El enemigo no atraviesa una pared interna" {
    paredes.construir(paredes.horizontal(6, 6, 5))
    const enemigo = new EnemigoComun(position = game.at(5, 5))
    personaje.position(game.at(8, 5))
    enemigo.perseguir()
    assert.notEquals(game.at(6, 5), enemigo.position())
  }
}

describe "Flujo del juego" {
  method initialize() {
    game.width(15)
    game.height(20)
  }

  // puerta + sala limpia
  test "Al limpiar la sala la puerta lleva a la sala siguiente" {
    miJuego.entrarA(sala1)
    sala1.enemigosVivos().copy().forEach({ e => miJuego.eliminarEnemigo(e) })
    sala1.puerta().alColisionarConPersonaje()
    assert.equals(sala2, miJuego.salaActual())
  }

  // puerta bloqueada
  test "La puerta bloqueada no cambia de sala" {
    miJuego.entrarA(sala1)
    sala1.puerta().alColisionarConPersonaje()
    assert.equals(sala1, miJuego.salaActual())
  }

  // derrota + reinicio
  test "Tras perder, reiniciar vuelve a sala1 con el personaje restaurado" {
    miJuego.entrarA(sala1)
    miJuego.terminarJuego()
    assert.notThat(miJuego.puedeJugar())
    miJuego.reiniciar()
    assert.equals(sala1, miJuego.salaActual())
    assert.equals(3, personaje.vidaActual())
    assert.that(temporizador.preparando())
  }
}

describe "Temporizador" {
  method initialize() {
    game.width(15)
    game.height(20)
  }

  // el reloj de la sala
  test "Cada segundo descuenta uno del tiempo mientras hay enemigos" {
    miJuego.entrarA(sala1)
    temporizador.pasarSegundo()
    assert.equals("tiempo: " + (sala1.tiempoLimite() - 1), temporizador.text())
  }

  // derrota por tiempo
  test "Al llegar el tiempo a cero el juego termina" {
    miJuego.entrarA(sala1)
    sala1.tiempoLimite().times({ i => temporizador.pasarSegundo() })
    assert.notThat(miJuego.puedeJugar())
  }

  // cuenta regresiva inicial
  test "Durante la preparacion no se puede jugar y al terminar si" {
    miJuego.entrarA(sala1)
    temporizador.iniciarPreparacion(2)
    assert.notThat(miJuego.puedeJugar())
    2.times({ i => temporizador.pasarSegundo() })
    assert.that(miJuego.puedeJugar())
  }
}

describe "Combate" {
  method initialize() {
    game.width(15)
    game.height(20)
    game.addVisual(personaje)
  }

  // derrota por vidas
  test "Si los enemigos le quitan todas las vidas el juego termina" {
    const enemigo = new EnemigoComun(position = game.at(5, 5))
    3.times({ i => enemigo.alColisionarConPersonaje() })
    assert.equals(0, personaje.vidaActual())
    assert.notThat(miJuego.puedeJugar())
  }
}

// ---------------------------------------------------------------------------
// Personaje: municiones, vida y movimiento
// ---------------------------------------------------------------------------
describe "Personaje: municiones, vida y movimiento" {
  method initialize() {
    game.width(15)
    game.height(20)
    game.addVisual(personaje)
  }

  test "Cambiar de municion recorre las balas que tiene de forma ciclica" {
    personaje.adquirirMunicion(balaPlata)
    personaje.cambiarMunicion()
    assert.equals(balaPlata, personaje.municionActual())
    personaje.cambiarMunicion()
    assert.equals(balaComun, personaje.municionActual())
  }

  test "Adquirir dos veces la misma municion no la duplica" {
    personaje.adquirirMunicion(balaPlata)
    personaje.adquirirMunicion(balaPlata)
    personaje.cambiarMunicion()
    personaje.cambiarMunicion()
    // si estuviera duplicada, la actual seguiria siendo la de plata
    assert.equals(balaComun, personaje.municionActual())
  }

  test "La vida del personaje nunca baja de cero" {
    5.times({ i => personaje.perderVidaActual() })
    assert.equals(0, personaje.vidaActual())
  }

  test "Retroceder devuelve al personaje a la posicion anterior" {
    personaje.position(game.at(5, 5))
    personaje.mover(game.at(6, 5))
    assert.equals(game.at(6, 5), personaje.position())
    personaje.retroceder()
    assert.equals(game.at(5, 5), personaje.position())
  }
}

// ---------------------------------------------------------------------------
// Items: cada uno reacciona distinto al colisionar con el personaje (polimorfismo)
// ---------------------------------------------------------------------------
describe "Items" {
  method initialize() {
    game.width(15)
    game.height(20)
    game.addVisual(personaje)
  }

  test "La pocion de vida recupera vida al colisionar" {
    2.times({ i => personaje.perderVidaActual() })
    personaje.reaccionarAColision(new PocionDeVida())
    assert.equals(2, personaje.vidaActual())
  }

  test "La armadura aumenta la vida maxima y permite curarse por encima de la original" {
    personaje.reaccionarAColision(armadura)
    assert.equals(7, personaje.vidaMaxima())
    personaje.recuperarVidaActual(10)
    assert.equals(7, personaje.vidaActual())
  }

  test "El arma mejorada aumenta el danio que le hace el personaje a los enemigos" {
    const enemigo = new EnemigoComun(position = game.at(5, 5))
    personaje.reaccionarAColision(armaMejorada)
    assert.equals(50, personaje.danioActual())
    enemigo.recibirDanio(balaComun)
    assert.equals(50, enemigo.vida())
  }

  test "Un item de municion le da la bala al personaje y desaparece del tablero" {
    const item = new ItemMunicion(bala = balaPlata, image = "itemPlata.png", position = game.at(3, 3))
    game.addVisual(item)
    personaje.reaccionarAColision(item)
    assert.notThat(game.allVisuals().contains(item))
    personaje.cambiarMunicion()
    assert.equals(balaPlata, personaje.municionActual())
  }
}