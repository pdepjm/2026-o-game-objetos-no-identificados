// ---------------------------------------------------------------------------
// Ataque del personaje
// ---------------------------------------------------------------------------
describe "Ataque del personaje" {
  method initialize() {
    game.width(15)
    game.height(20)
    game.addVisual(personaje)
    personaje.reiniciar()
  }

  test "El personaje ataca a un enemigo en la posicion indicada" {
    const enemigo = new EnemigoComun(position = game.at(6, 5))
    game.addVisual(enemigo)
    personaje.atacarEn(game.at(6, 5))
    assert.equals(75, enemigo.vida())
  }

  test "Atacar una posicion sin enemigo no produce efecto" {
    personaje.atacarEn(game.at(10, 10))
    assert.equals(3, personaje.vidaActual())
  }
}

// ---------------------------------------------------------------------------
// Tablero: limites del area de juego
// ---------------------------------------------------------------------------
describe "Tablero" {
  method initialize() {
    game.width(15)
    game.height(20)
    game.addVisual(personaje)
    personaje.reiniciar()
  }

  test "Una posicion central es transitable" {
    assert.that(tablero.esTransitable(game.at(5, 5)))
  }

  test "El borde del tablero no es transitable" {
    assert.notThat(tablero.esTransitable(game.at(0, 0)))
  }


  
