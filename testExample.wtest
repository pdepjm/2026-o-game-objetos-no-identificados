import wollok.game.*
import salas.*
import personaje.*
import enemigos.*
import puerta.*

describe "Personaje" {
  test "Pierde una vida cuando recibe un ataque" {
    game.addVisual(personaje)
    personaje.perderVidaActual()
    assert.equals(2, personaje.vidaActual())
  }

  test "Al recuperar vida no supera la vida máxima" {
    game.addVisual(personaje)
    personaje.perderVidaActual()
    personaje.recuperarVidaActual(5)
    assert.equals(3, personaje.vidaActual())
  }
}

describe "Enemigo" {
  test "Recibe daño" {
    const enemigo = new EnemigoComun(position = game.at(5, 5))
    game.addVisual(enemigo)
    enemigo.recibirDanio()
    assert.equals(75, enemigo.vida())
  }

  test "Muere cuando su vida llega a cero" {
    const enemigo = new EnemigoComun(position = game.at(5, 5))
    game.addVisual(enemigo)

    4.times({ i => enemigo.recibirDanio() })

    assert.that(enemigo.estaMuerto())
  }
}

describe "Puerta" {
  test "La puerta comienza bloqueada" {
    const puerta = new Puerta(destino = sala2)
    assert.notThat(puerta.desbloqueada())
  }
}

describe "Sala" {
  test "La sala comienza con enemigos" {
    sala1.inicializarse()
    assert.notThat(sala1.estaLimpia())
  }
}